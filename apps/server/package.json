{
  "name": "@playlist-recall/server",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "inference": "tsx src/inference.ts",
    "migrate": "tsx src/migrate.ts",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "test:dj": "vitest run tests/dj-*.test.ts tests/music-search.test.ts tests/music-matching.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playlist-recall/core": "*",
    "ai": "7.0.153",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.3.1",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "swagger-ui-dist": "5.34.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
