{
  "name": "@sillage/server",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/boot.ts | pino-pretty",
    "dev:worker": "tsx src/worker.ts | pino-pretty",
    "dev:inference": "tsx src/inference.ts | pino-pretty",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/boot.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "start:inference": "node --enable-source-maps dist/inference.js",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "test:dj": "vitest run tests/dj-*.test.ts tests/music-search.test.ts tests/music-matching.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sillage/core": "*",
    "ai": "7.0.153",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.3.1",
    "hono": "4.13.13",
    "hono-pino": "0.10.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "swagger-ui-dist": "5.34.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
