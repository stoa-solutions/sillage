/// Worker queue leased with PostgreSQL row locks. At most one pending or running job per key.
/// The expression index jobs_musicbrainz_video lives in the migration.
model Job {
  id          String    @id @db.Uuid
  kind        String
  dedupeKey   String    @map("dedupe_key")
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseId     String?   @map("lease_id") @db.Uuid
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([dedupeKey], map: "jobs_active_key", where: raw("(status = ANY (ARRAY['pending'::text, 'running'::text]))"))
  @@index([status, availableAt], map: "jobs_due")
  @@map("jobs")
}

/// YouTube Data API units spent per day.
model QuotaUsage {
  day   DateTime @id @db.Date
  units Int      @default(0)

  @@map("quota_usage")
}
