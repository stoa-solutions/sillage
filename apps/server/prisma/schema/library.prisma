/// A YouTube playlist. The catalogue is shared; ownership is UserPlaylist.
model Playlist {
  id          String    @id
  title       String
  sourceUrl   String    @map("source_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)
  nextSyncAt  DateTime  @default(now()) @map("next_sync_at") @db.Timestamptz(6)
  syncEnabled Boolean   @default(true) @map("sync_enabled")
  generation  BigInt    @default(0)
  status      String    @default("pending")
  error       String?

  memberships Membership[]
  syncRuns    SyncRun[]
  owners      UserPlaylist[]

  @@map("playlists")
}

model UserPlaylist {
  userId     String   @map("user_id") @db.Uuid
  playlistId String   @map("playlist_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, playlistId])
  @@map("user_playlists")
}

/// A public YouTube video and its text index state.
model Video {
  id                  String                   @id
  title               String?
  channel             String?
  channelId           String?                  @map("channel_id")
  durationSeconds     Float?                   @map("duration_seconds")
  description         String                   @default("")
  tags                Json                     @default("[]")
  publishedAt         String?                  @map("published_at")
  thumbnailUrl        String                   @map("thumbnail_url")
  contentHash         String                   @map("content_hash")
  indexHash           String?                  @map("index_hash")
  enrichedAt          DateTime?                @map("enriched_at") @db.Timestamptz(6)
  available           Boolean                  @default(true)
  imageHash           String?                  @map("image_hash")
  imageCheckedAt      DateTime?                @map("image_checked_at") @db.Timestamptz(6)
  imageError          String?                  @map("image_error")
  musicMetadata       Json?                    @map("music_metadata")
  /// GENERATED ALWAYS ... STORED in PostgreSQL (see 0_init), which Prisma cannot model: never
  /// written by the application. `prisma migrate dev` proposes `DROP DEFAULT` on the two
  /// generated columns; delete those lines from a new migration (PostgreSQL would refuse them).
  searchDocument      Unsupported("tsvector")? @map("search_document")
  /// GENERATED ALWAYS ... STORED from music_metadata.searchText, like searchDocument.
  musicSearchDocument Unsupported("tsvector")? @map("music_search_document")

  memberships   Membership[]
  passages      Passage[]
  image         VideoImage?
  lyrics        Lyrics?
  lyricsOffsets LyricsOffset[]

  @@index([searchDocument], map: "videos_lexical", type: Gin)
  @@index([musicSearchDocument], map: "videos_music_lexical", type: Gin)
  @@map("videos")
}

/// A video's place in a playlist, kept inactive when it disappears from YouTube.
model Membership {
  key            String    @id
  playlistId     String    @map("playlist_id")
  videoId        String    @map("video_id")
  position       Int
  addedAt        DateTime? @map("added_at") @db.Timestamptz(6)
  seenGeneration BigInt    @map("seen_generation")
  missingCount   Int       @default(0) @map("missing_count")
  active         Boolean   @default(true)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([playlistId, active, position], map: "memberships_playlist")
  @@index([videoId, active], map: "memberships_video")
  @@map("memberships")
}

model SyncRun {
  id         String    @id @db.Uuid
  playlistId String    @map("playlist_id")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  status     String    @default("running")
  entries    Int?
  error      String?

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sync_runs")
}

model Channel {
  id        String   @id
  avatarUrl String?  @map("avatar_url")
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("channels")
}

model MusicbrainzCache {
  url       String   @id
  response  Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("musicbrainz_cache")
}
