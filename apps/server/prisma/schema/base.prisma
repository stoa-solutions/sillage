// Prisma reads every file in this folder as one schema: one file per domain.
// Database names stay snake_case (@map); the generated client is camelCase.

generator client {
  provider        = "prisma-client"
  output          = "../../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  // Half the size of the default query compiler: the API runs within 192 MB.
  compilerBuild   = "small"
}

datasource db {
  provider = "postgresql"
}

/// Versions applied by the pre-Prisma migration script; kept so the baseline stays idempotent.
model LegacySchemaMigration {
  version   Int      @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}
