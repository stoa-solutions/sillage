/// CHECK outcome IN ('finished','skipped','unavailable','replaced') lives in the migration.
model ListeningEvent {
  userId     String   @map("user_id") @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  videoId    String   @map("video_id")
  title      String
  channel    String?
  outcome    String
  playedAt   DateTime @map("played_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, eventId])
  @@index([userId, playedAt(sort: Desc)], map: "listening_history_recent")
  @@map("listening_history")
}

model Lyrics {
  videoId         String   @id @map("video_id")
  status          String
  sourceId        BigInt?  @map("source_id")
  lines           Json     @default("[]")
  plainText       String?  @map("plain_text")
  durationDeltaMs Int?     @map("duration_delta_ms")
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("lyrics")
}

model LyricsOffset {
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id")
  offsetMs  Int      @map("offset_ms")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, videoId])
  @@map("lyrics_offsets")
}
