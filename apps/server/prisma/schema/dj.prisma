/// Private DJ diagnostics. Scope, trigger, origin and status CHECKs live in the migration.
model DjConversation {
  userId    String   @map("user_id") @db.Uuid
  id        String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  turns  DjTurn[]
  events DjJournalEvent[]

  @@id([userId, id])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "dj_conversations_recent")
  @@map("dj_conversations")
}

model DjTurn {
  id              String    @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  installationId  String?   @map("installation_id") @db.Uuid
  requestId       String?   @map("request_id") @db.Uuid
  scope           String
  requestedScope  String?   @map("requested_scope")
  trigger         String
  status          String    @default("running")
  input           Json
  plan            Json
  response        Json?
  model           String?
  promptHash      String    @map("prompt_hash")
  releaseSha      String    @map("release_sha")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  journalComplete Boolean   @default(false) @map("journal_complete")

  conversation DjConversation   @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  events       DjJournalEvent[]

  @@id([userId, id])
  @@index([userId, conversationId, startedAt(sort: Desc), id(sort: Desc)], map: "dj_turns_conversation")
  @@index([userId, requestId], map: "dj_turns_request", where: raw("(request_id IS NOT NULL)"))
  @@map("dj_turns")
}

model DjJournalEvent {
  sequence       BigInt    @default(autoincrement())
  userId         String    @map("user_id") @db.Uuid
  id             String    @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  turnId         String?   @map("turn_id") @db.Uuid
  scope          String
  origin         String
  kind           String
  payload        Json
  clientSequence Int?      @map("client_sequence")
  occurredAt     DateTime? @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  conversation DjConversation @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  turn         DjTurn?        @relation(fields: [userId, turnId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, id])
  @@index([userId, conversationId, sequence], map: "dj_journal_conversation")
  @@index([userId, turnId, sequence], map: "dj_journal_turn", where: raw("(turn_id IS NOT NULL)"))
  @@map("dj_journal_events")
}
