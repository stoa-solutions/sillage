/// A Google account, or the historical library from before accounts existed.
model User {
  id              String   @id @db.Uuid
  googleSub       String?  @unique @map("google_sub")
  email           String?
  name            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// On the historical user only: the Google account that took its library over.
  legacyClaimedBy String?  @map("legacy_claimed_by") @db.Uuid
  /// "google", "anthropic", or "legacy" for the untouched historical account.
  djProvider      String   @default("google") @map("dj_provider")

  claimedBy       User?                 @relation("LegacyClaim", fields: [legacyClaimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  claimed         User[]                @relation("LegacyClaim")
  sessions        SessionToken[]
  oauthGrants     OAuthGrant[]
  aiCredentials   AccountAiCredential[]
  djSettings      AccountDjSettings?
  djUsage         AccountDjUsage[]
  playlists       UserPlaylist[]
  listening       ListeningEvent[]
  lyricsOffsets   LyricsOffset[]
  djConversations DjConversation[]

  @@map("users")
}

/// One signed-in installation. Only the SHA-256 of the bearer token is stored.
model SessionToken {
  id        String    @id @db.Uuid
  name      String
  hash      String    @unique
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userId    String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @map("user_id") @db.Uuid
  /// Null for personal tokens created by the CLI: they never expire, they are revoked.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legacyDjSettings LegacyDjSettings?

  @@index([userId], map: "tokens_user")
  @@map("tokens")
}

/// A Google sign-in in progress (10 minutes), bound to the browser by a cookie.
model OAuthFlow {
  stateHash  String   @id @map("state_hash")
  cookieHash String   @map("cookie_hash")
  /// PKCE S256 challenge of the native app.
  challenge  String
  appState   String   @map("app_state")
  nonce      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("oauth_flows")
}

/// The one-time code handed back to the app (90 seconds), exchanged with the PKCE verifier.
model OAuthGrant {
  codeHash  String   @id @map("code_hash")
  userId    String   @map("user_id") @db.Uuid
  challenge String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("oauth_grants")
}

/// A personal AI key per provider, AES-256-GCM encrypted with the user id as AAD.
/// CHECK provider IN ('google','anthropic') lives in the migration.
model AccountAiCredential {
  userId       String   @map("user_id") @db.Uuid
  provider     String
  encryptedKey String   @map("encrypted_key")
  model        String
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, provider])
  @@map("account_ai_credentials")
}

/// Google mirror of AccountAiCredential kept for older servers during a rollback.
model AccountDjSettings {
  userId       String   @id @map("user_id") @db.Uuid
  encryptedKey String   @map("encrypted_key")
  model        String
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("account_dj_settings")
}

model AccountDjUsage {
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  requests Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, day])
  @@map("account_dj_usage")
}

/// Pre-account DJ key, attached to a personal token.
model LegacyDjSettings {
  tokenId      String   @id @map("token_id") @db.Uuid
  encryptedKey String   @map("encrypted_key")
  model        String
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  token SessionToken @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("dj_settings")
}

/// Server-wide DJ budget for the environment key.
model DjUsage {
  day      DateTime @id @db.Date
  requests Int      @default(0)

  @@map("dj_usage")
}
