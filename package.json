{
  "name": "playlist-recall",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @playlist-recall/extension",
    "build": "npm run build -w @playlist-recall/extension",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare:model": "node scripts/prepare-model.mjs",
    "prepare:seed": "node scripts/seed-vectors.mjs",
    "package:local": "npm run build && node scripts/package-local.mjs",
    "dev:server": "npm run dev -w @playlist-recall/server",
    "test:integration": "npm run test:integration -w @playlist-recall/server"
  }
}
