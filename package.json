{
  "name": "playlist-recall",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:generate": "tsx apps/server/src/api-docs/generate.ts",
    "docs:check": "tsx apps/server/src/api-docs/generate.ts --check",
    "docs:serve": "tsx apps/server/src/api-docs/server.ts",
    "docs:connect": "tsx apps/server/src/api-docs/connect.ts",
    "dev": "npm run dev -w @playlist-recall/extension",
    "build": "npm run build -w @playlist-recall/extension",
    "check": "npm run docs:check && npm run check:architecture && npm run check --workspaces --if-present",
    "test": "node --test scripts/dj-eval/*.test.mjs && npm run test --workspaces --if-present",
    "prepare:model": "node scripts/prepare-model.mjs",
    "prepare:seed": "node scripts/seed-vectors.mjs",
    "package:local": "npm run build && node scripts/package-local.mjs",
    "dev:server": "npm run dev -w @playlist-recall/server",
    "test:integration": "npm run test:integration -w @playlist-recall/server",
    "package:webstore": "npm run build && python3 scripts/package-webstore.py",
    "build:macos": "python3 scripts/build-macos.py --universal",
    "test:macos": "swift build --package-path apps/macos && swift run --skip-build --package-path apps/macos RecallCoreTests && swift run --skip-build --package-path apps/macos RecallAudioTests && swift run --skip-build --package-path apps/macos RecallServerTests",
    "verify": "npm run verify:node && npm run verify:macos",
    "verify:node": "npm run check && npm test && npm run build && npm run build -w @playlist-recall/server",
    "verify:macos": "npm run test:packaging && npm run test:macos",
    "board": "sh scripts/board.sh",
    "check:architecture": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "test:dj": "node --test scripts/dj-eval/*.test.mjs && npm run test:dj -w @playlist-recall/server",
    "eval:dj": "node scripts/dj-eval/run.mjs",
    "test:packaging": "python3 -m unittest discover -s scripts -p 'test_macos_release.py'"
  }
}
