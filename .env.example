DATABASE_URL=postgresql://sillage:CHANGE_ME@sillage-db:5432/sillage
YOUTUBE_API_KEY=
SYNC_ENABLED=false
VISION_ENABLED=true
RELEASE_SHA=local
MODEL_PATH=/models/
PORT=3001
INFERENCE_URL=http://inference:3002
# Daily YouTube Data API units the server allows itself (Google's default quota is 10 000).
YOUTUBE_DAILY_BUDGET=8000
# Private SearXNG for Discover; empty uses YouTube search.list.
SEARXNG_URL=
# Required by the searxng service of docker-compose: a long random string.
SEARXNG_SECRET=
# Google sign-in (OAuth web client); both or neither. Secret stays server side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Directory of the published Mac archives and Sparkle feed.
MAC_RELEASES_DIR=/releases
# Optional identified LRCLIB key for lyrics.
LRCLIB_API_KEY=

# Optional legacy/server account only; never included in clients.
# Set DJ_PROVIDER=google or anthropic for a native adapter.
# Empty retains the existing OpenAI-compatible DJ_BASE_URL transport.
DJ_PROVIDER=
DJ_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DJ_MODEL=gemini-3.5-flash-lite
DJ_API_KEY=
DJ_DAILY_REQUEST_LIMIT=100
# Per-account overrides, JSON: {"<account uuid>": 300} or {"<uuid>": {"unlimitedUntil": "2026-12-31"}}
DJ_ACCOUNT_DAILY_LIMITS=
# DJ turns at once on this instance.
DJ_CONCURRENT_TURNS=2
# 32 random bytes encoded as 64 hex characters. Preserve in backups.
DJ_SETTINGS_ENCRYPTION_KEY=
PUBLIC_URL=https://sillage.stoa.solutions
ALLOWED_ORIGINS=https://sillage.stoa.solutions

# Pilot: at most 10 explicit YouTube video IDs.
MUSICBRAINZ_PILOT_IDS=

# Progressive opt-in: comma-separated account UUIDs, empty keeps pilot-only mode.
# At most ten MusicBrainz jobs pending/running across all enabled accounts.
MUSICBRAINZ_ACCOUNT_IDS=

# Optional native provider endpoints; administrator-controlled, never supplied by clients.
AI_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
