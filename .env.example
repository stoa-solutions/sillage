DATABASE_URL=postgresql://playlist_recall:CHANGE_ME@playlist-recall-db:5432/playlist_recall
YOUTUBE_API_KEY=
SYNC_ENABLED=false
VISION_ENABLED=true
RELEASE_SHA=local
MODEL_PATH=/models/

# Gemini configuration for this private server (never included in clients)
DJ_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DJ_MODEL=gemini-3.5-flash-lite
DJ_API_KEY=
DJ_DAILY_REQUEST_LIMIT=100
# 32 random bytes encoded as 64 hex characters. Preserve in backups.
DJ_SETTINGS_ENCRYPTION_KEY=
ALLOWED_ORIGINS=https://recall.stoa.solutions

# Pilot: at most 10 explicit YouTube video IDs.
MUSICBRAINZ_PILOT_IDS=

# Progressive opt-in: comma-separated account UUIDs, empty keeps pilot-only mode.
# At most ten MusicBrainz jobs pending/running across all enabled accounts.
MUSICBRAINZ_ACCOUNT_IDS=
